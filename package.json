{
  "name": "@ygghq/ymacs",
  "version": "0.1.3",
  "description": "ymacs - GNU Emacs fork on libyggterm in Common Lisp",
  "bin": {
    "ymacs": "bin/ymacs",
    "ymacs-bin": "bin/ymacs-bin"
  },
  "ynpm": {
    "build": "sbcl --noinform --disable-debugger --no-sysinit --no-userinit --load build.lisp && cp ymacs-bin bin/ymacs-bin",
    "bins": {
      "ymacs": "bin/ymacs",
      "ymacs-bin": "bin/ymacs-bin"
    },
    "watch": "@ygghq/ymacs"
  },
  "yggterm": {
    "schema": 1,
    "app": {
      "name": "ymacs",
      "binary": "ymacs",
      "label": "Ymacs",
      "icon": "Ξ",
      "keytip": "y",
      "verbs": [
        {
          "id": "open",
          "label": "Open Ymacs",
          "args": [],
          "row_spawn": true
        }
      ],
      "context_menu": {
        "enabled": true,
        "contexts": ["workspace", "session"],
        "verbs": ["open"]
      }
    }
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "init.org"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yggdrasilhq/ymacs.git"
  },
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
